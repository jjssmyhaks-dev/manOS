[TEMPLATE]
# Factory AI OS — environment

# Remote Postgres (Neon/Supabase). When set, ALL data (entities, approvals,
# documents, traces) goes to this database instead of local PGlite.
# Get one: https://console.neon.tech → project → connection string
DATABASE_URL=

# AI model (optional — Settings UI can store a per-org OpenRouter key instead)
# OPENROUTER_API_KEY=sk-or-v1-...   # PLATFORM-side key (the operator sets this; subscribers never paste keys)
# AI_PROFILE=prod
# AI_MODEL_ROUTE=default|budget

# Dev storage override (advanced)
# FACTORY_DB_DIR=./.pglite-data   # custom local PGlite dir
# FACTORY_DB_MEMORY=1             # force in-memory (evals/CI set this automatically)

# Cron guard for POST /api/jobs/daily
# CRON_SECRET=

# WhatsApp Cloud API (webhook signature + hub verification)
# WHATSAPP_APP_SECRET=
# WHATSAPP_VERIFY_TOKEN=factory-demo

# Zoho Books OAuth (operator client — enables one-click "Connect Zoho")
# ZOHO_CLIENT_ID=
# ZOHO_CLIENT_SECRET=
# ZOHO_REGION=in
# --- WhatsApp Cloud API outbound (optional; echo mode without these) ---
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ECHO=1   # force echo even with creds (safe staging). Evals always run on in-memory Postgres (FACTORY_DB_MEMORY=1) — never remote.

# Sarvam AI speech-to-text for WhatsApp voice notes (optional; without it the
# bot politely asks senders to type their question)
# SARVAM_API_KEY=
# SARVAM_STT_MODEL=saarika:v2.5

# --- Machine telemetry ingest (Agent 13 P2b) -------------------------------
# Shared secret the edge gateway sends as `Authorization: Bearer <token>`;
# org-scoped variant "<token>:<orgId>" is also accepted. Unset = open (dev only).
# MACHINE_INGEST_TOKEN=

# --- e-Invoice / e-way bill GSP (optional; sandbox by default) --------------
# Provider behind packages/connectors gsp.ts — swap by config, charge as pass-through
# GSP_PROVIDER=gstzen          # 'sandbox' (default) | 'gstzen'
# GSTZEN_API_KEY=

# --- Deploy notes -----------------------------------------------------------
# Vercel Cron (vercel.json) hits /api/jobs/daily 02:30 UTC and
# /api/jobs/pilot-digest Mondays 06:00 UTC — set CRON_SECRET so POST is guarded.
# External uptime monitor (BetterStack/UptimeRobot) → GET /api/health.
# Operator smoke test after deploy: BASE_URL=https://your-app npm run smoke -w apps/web
